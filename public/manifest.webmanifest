{
  "name": "NovaCut Studio — Professional Video Editor",
  "short_name": "NovaCut",
  "description": "Professional-grade video editing, fully local in your browser. Trim, cut, text, stickers, filters, motion and export — nothing leaves your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "orientation": "any",
  "background_color": "#07070d",
  "theme_color": "#07070d",
  "categories": ["video", "multimedia", "productivity"],
  "shortcuts": [
    {
      "name": "New project",
      "short_name": "New",
      "description": "Start editing from a blank canvas",
      "url": "/?action=new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Try the demo project",
      "short_name": "Demo",
      "description": "Load a ready-made demo edit",
      "url": "/?action=demo",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Export video",
      "short_name": "Export",
      "description": "Jump straight to the export dialog",
      "url": "/?action=export",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
