// NovaCut Studio — Prisma schema
//
// Local development:  DATABASE_URL="file:./db/novacut.db"   (plain SQLite)
// Production (Vercel + Turso): TURSO_DATABASE_URL + TURSO_AUTH_TOKEN set →
//   src/lib/cloud/db.ts transparently binds the client to Turso through
//   @prisma/adapter-libsql (driver adapters — same SQLite dialect).
//
// Sync the schema to Turso with:  bun run db:init:turso
// (see scripts/init-turso.mjs)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cloud sync — device-scoped project backup (v1: no accounts, deviceId only)
// ---------------------------------------------------------------------------

model CloudProject {
  id        String   @id @default(cuid())
  deviceId  String
  /// id of the project inside the browser's IndexedDB
  localId   String
  name      String
  duration  Float    @default(0)
  clipCount Int      @default(0)
  /// small data-URL preview (optional)
  thumbnail String?
  /// full project JSON payload
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, localId])
  @@index([deviceId, updatedAt])
}

// ---------------------------------------------------------------------------
// Media manifest — sha-256 hash map of the media files a backup references.
// Day 41: the manifest travels WITH the project payload so any device can
// tell exactly which binaries a restore needs (binaries sync lands Day 42).
// ---------------------------------------------------------------------------

model CloudAsset {
  id        String   @id @default(cuid())
  deviceId  String
  /// CloudProject.localId this manifest belongs to
  projectId String
  /// media asset id inside the browser's IndexedDB
  assetId   String
  name      String
  kind      String
  mimeType  String
  size      Int      @default(0)
  duration  Float    @default(0)
  width     Int      @default(0)
  height    Int      @default(0)
  /// sha-256 hex of the blob — content identity for re-link + dedupe
  hash      String
  /// base64 of the blob once uploaded (Day 42) — null = manifest-only
  data      String?
  /// server-verified upload timestamp (set only after hash verification)
  uploadedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, projectId, assetId])
  @@index([deviceId, projectId])
  @@index([hash])
}

// ---------------------------------------------------------------------------
// Share links — read-only project snapshots reachable by token
// ---------------------------------------------------------------------------

model ShareLink {
  id        String   @id @default(cuid())
  token     String   @unique
  deviceId  String
  projectId String
  title     String
  /// snapshot JSON rendered by the viewer
  payload   String
  views     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

// ---------------------------------------------------------------------------
// Feedback — one-tap ratings + messages from the editor
// ---------------------------------------------------------------------------

model Feedback {
  id        String   @id @default(cuid())
  deviceId  String
  rating    Int?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
