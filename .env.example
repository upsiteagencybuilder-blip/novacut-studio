# ------------------------------------------------------------------
# NovaCut Studio — environment template
# Copy to .env  (cp .env.example .env)  and fill the values.
# On Vercel these are pushed automatically:  bun run env:push
# ------------------------------------------------------------------

# Local SQLite database (used when Turso vars are absent)
DATABASE_URL=file:./db/novacut.db

# Turso (libSQL) cloud database — the production source of truth.
# When both vars are set, the app automatically uses Turso via
# @prisma/adapter-libsql; otherwise it falls back to local SQLite.
TURSO_DATABASE_URL=libsql://YOUR-DB-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
